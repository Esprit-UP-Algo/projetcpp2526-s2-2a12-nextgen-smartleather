  <property name="styleSheet">
   <string notr="true">
    QMainWindow { background-color: #FCF9F6; }

    #sidebar { background-color: #3D362D; border-right: 1px solid #4E2C23; }
    #sidebar QPushButton { background-color: transparent; color: #F2D2B5; text-align: left; padding: 15px 20px; border: none; font-weight: bold; text-transform: uppercase; font-size: 12px; }
    #sidebar QPushButton:hover { background-color: #4E2C23; color: #C68E65; border-left: 4px solid #C68E65; }

    #top_nav { background-color: white; border-bottom: 2px solid #F2D2B5; }
    #top_nav QPushButton { background-color: transparent; border: none; padding: 10px 14px; color: #8B4513; font-size: 12px; font-weight: 700; border-radius: 10px; margin: 4px; }
    #top_nav QPushButton:hover { background-color: #FFF0E0; color: #4E2C23; }
    #top_nav QPushButton:checked { background-color: #C68E65; color: white; }

    QLabel { color: #4E2C23; font-size: 13px; font-weight: bold; }
    QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
      background-color: #FFFCFA; border: 1px solid #DDC6B0; padding: 14px 16px; border-radius: 12px; color: #3D362D; font-size: 14px; min-height: 48px;
    }
    QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
      border: 2px solid #C68E65; background-color: white;
    }
    QComboBox QAbstractItemView { background-color: white; color: black; selection-background-color: #C68E65; selection-color: white; border: 1px solid #D2B48C; }

    /* Boutons primaires / secondaires (objectNames réels) */
    #btn_mat_add, #btn_upd_confirm, #btn_upd_load, #btn_export_pdf, #btn_show_stats, #btn_notify_stock, #btn_chatbot_waste { background-color: #8B4513; color: white; border-radius: 10px; padding: 12px 26px; font-weight: bold; border: none; }
    #btn_mat_add:hover, #btn_upd_confirm:hover, #btn_upd_load:hover, #btn_export_pdf:hover, #btn_show_stats:hover, #btn_notify_stock:hover, #btn_chatbot_waste:hover { background-color: #4E2C23; }

    #btn_del_confirm { background-color: #8B0000; color: white; border-radius: 10px; padding: 12px 26px; font-weight: bold; border: none; }
    #btn_del_confirm:hover { background-color: #600000; }

    QTableWidget { background-color: white; color: #3D362D; gridline-color: #F2D2B5; border: none; alternate-background-color: #FFFCFA; selection-background-color: #F2D2B5; selection-color: #4E2C23; }
    QHeaderView::section { background-color: #3D362D; color: #F2D2B5; padding: 8px; border: none; font-weight: bold; }

    QProgressBar { background-color: #F5E9DE; border: 1px solid #E0D0C0; border-radius: 10px; text-align: center; color: white; font-weight: 700; min-height: 20px; }
    QProgressBar::chunk { border-radius: 10px; }
    #pb_yield::chunk { background-color: #4CAF50; }
    #pb_loss::chunk { background-color: #F44336; }
     </string>
