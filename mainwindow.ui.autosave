  <property name="styleSheet">
   <string>QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0d0d0d, stop:1 #1a1a1a);
}
QWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0d0d0d, stop:1 #1a1a1a);
    color: #f5f5dc;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #A0522D, stop:1 #8B4513);
    color: white;
    border: 2px solid #6B3410;
    padding: 10px 15px;
    border-radius: 8px;
    font-weight: bold;
    font-size: 11px;
    outline: none;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #B8613C, stop:1 #9B5024);
    border: 2px solid #8B4513;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6B3410, stop:1 #5a2a0b);
    border: 2px solid #4a1f08;
}
QLineEdit, QSpinBox, QComboBox, QDateEdit, QDoubleSpinBox {
    background-color: #f5f5dc;
    color: #1a1a1a;
    border: 2px solid #8B7355;
    padding: 8px;
    border-radius: 6px;
    font-weight: 500;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus {
    border: 2px solid #A0522D;
    background-color: #fffef9;
}
QLabel {
    color: #f5f5dc;
    font-weight: bold;
    font-size: 10pt;
}
QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B6F47, stop:1 #7A5F38);
    color: #ffffff;
    border: 3px solid #A0522D;
    border-radius: 10px;
    padding: 15px;
    font-weight: bold;
    font-size: 11pt;
    margin-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 5px 0 5px;
    color: #f5f5dc;
    font-weight: bold;
}
QTabWidget::pane {
    border: 3px solid #A0522D;
    background-color: #1a1a1a;
}
QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6B5D52, stop:1 #544945);
    color: #d4af99;
    padding: 10px 25px;
    border: 2px solid #4a423c;
    border-radius: 6px 6px 0px 0px;
    margin-right: 2px;
    font-weight: bold;
}
QTabBar::tab:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7a6b5f, stop:1 #5a5248);
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #B8613C, stop:1 #A0522D);
    color: #ffffff;
    border: 2px solid #8B4513;
}
QTableWidget {
    background-color: #D2B48C;
    alternate-background-color: #E8D5C4;
    gridline-color: #A0826D;
    border: 2px solid #8B7355;
    border-radius: 6px;
}
QTableWidget::item {
    padding: 8px;
    border-right: 1px solid #A0826D;
    border-bottom: 1px solid #A0826D;
}
QTableWidget::item:selected {
    background-color: #A0522D;
    color: #ffffff;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #A0522D, stop:1 #8B4513);
    color: #ffffff;
    padding: 8px;
    border: none;
    border-right: 1px solid #6B3410;
    font-weight: bold;
    font-size: 10pt;
}
QScrollBar:vertical {
    background-color: #2a2a2a;
    width: 12px;
    border: 1px solid #4a423c;
}
QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8B7355, stop:1 #A0826D);
    border-radius: 6px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #A0826D, stop:1 #B8967D);
}</string>
