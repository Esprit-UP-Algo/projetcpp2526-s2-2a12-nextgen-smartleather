  <property name="styleSheet">
   <string notr="true">
    QMainWindow { background-color: #FCF9F6; }
    
    #sidebar { background-color: #3D362D; border-right: 1px solid #4E2C23; }
    #sidebar QPushButton { background-color: transparent; color: #F2D2B5; text-align: left; padding: 15px 20px; border: none; font-weight: bold; text-transform: uppercase; font-size: 12px; }
    #sidebar QPushButton:hover { background-color: #4E2C23; color: #C68E65; border-left: 4px solid #C68E65; }
    
    #top_nav { background-color: white; border-bottom: 2px solid #F2D2B5; }
    #top_nav QPushButton { background-color: transparent; border: none; padding: 12px 25px; color: #8B4513; font-size: 13px; font-weight: 600; border-radius: 6px; margin: 5px; }
    #top_nav QPushButton:hover { background-color: #FFF0E0; color: #4E2C23; }
    #top_nav QPushButton:checked { background-color: #C68E65; color: white; }
    
    #form_container, #table_container, #update_container { background-color: white; border: 1px solid #F2D2B5; border-radius: 15px; margin: 20px; }
    
    QLabel { color: #4E2C23; font-size: 13px; font-weight: bold; }
    QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit { 
        background-color: #FFFCFA; border: 1px solid #E0D0C0; padding: 10px; border-radius: 6px; color: #3D362D; font-size: 13px;
    }
    QComboBox {
        background-color: white; border: 1px solid #D2B48C; padding: 10px; border-radius: 6px; color: #000000; font-size: 13px;
    }
    QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
        border: 2px solid #C68E65; background-color: white;
    }
    QComboBox QAbstractItemView { background-color: white; color: black; selection-background-color: #C68E65; selection-color: white; border: 1px solid #D2B48C; }
    
    #btn_valider, #btn_update_confirm, #btn_search_update { background-color: #8B4513; color: white; border-radius: 6px; padding: 10px 30px; font-weight: bold; border: none; }
    #btn_valider:hover, #btn_update_confirm:hover, #btn_search_update:hover { background-color: #4E2C23; }
    
    #btn_delete_action { background-color: #4E2C23; color: white; border-radius: 6px; padding: 10px 30px; font-weight: bold; }
    #btn_delete_action:hover { background-color: #3D362D; }
    
    #btn_pdf { background-color: #C68E65; color: white; border-radius: 6px; padding: 8px 15px; font-weight: bold; border: none; }
    #btn_pdf:hover { background-color: #8B4513; }

    QTableWidget { background-color: white; color: #3D362D; gridline-color: #F2D2B5; border: none; alternate-background-color: #FFFCFA; selection-background-color: #F2D2B5; selection-color: #4E2C23; }
    QHeaderView::section { background-color: #3D362D; color: #F2D2B5; padding: 8px; border: none; font-weight: bold; }
