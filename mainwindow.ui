   <property name="styleSheet">
    <string notr="true">
QFrame#sidebar{
  background:#2b1d15;
  border-radius:16px;
}
QFrame#panel{
  background:#E9DDC9;
  border-radius:30px;
  border:1px solid rgba(59,42,31,60);
}
QLabel#lblTitle{
  font-size:22px;
  font-weight:800;
  color:#3B2A1F;
}
QLabel{
  font-size:15px;
  font-weight:650;
  color:#3B2A1F;
}
QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox{
  background:#F7F1E6;
  border:1px solid rgba(59,42,31,60);
  border-radius:14px;
  padding:6px 10px;
  min-height:30px;
  color:#3B2A1F;
}
QLabel#lblPhotoPreview{
  border:2px dashed rgba(59,42,31,120);
  border-radius:16px;
  background:transparent;
}
QPushButton{
  border-radius:16px;
  padding:12px 14px;
  font-size:18px;
  font-weight:800;
}

/* Menu buttons */
QPushButton#btnAccueil, QPushButton#btnEmployes, QPushButton#btnGestionCommandes, QPushButton#btnGestionMatiere{
  background:transparent;
  color:#F3E8D7;
  border:1px solid rgba(243,232,215,90);
  text-align:left;
  padding-left:14px;
}

/* Accueil actif */
QPushButton#btnAccueil{
  background:rgba(243,232,215,18);
}

/* Hover menu */
QPushButton#btnAccueil:hover, QPushButton#btnEmployes:hover,
QPushButton#btnGestionCommandes:hover, QPushButton#btnGestionMatiere:hover{
  background:rgba(243,232,215,12);
}

/* Buttons bottom */
QPushButton#btnDelete, QPushButton#btnSubmit{
  background:#6B3F2A;
  color:#F7F1E6;
  border:none;
}
QPushButton#btnDelete:hover, QPushButton#btnSubmit:hover{
  background:#5A3422;
}
QPushButton#btnChoosePhoto{
  background:#F1E7D7;
  color:#3B2A1F;
  border:1px solid rgba(59,42,31,60);
}
QPushButton#btnChoosePhoto:hover{
  background:#E7D7C0;
}
